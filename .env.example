# Recommended default: one StepFun subscription can cover chat, ASR, and TTS.
# Other providers require compatible chat, transcription, and speech endpoints.
# Remote Base URLs must use HTTPS. HTTP is accepted only for localhost/loopback services.
STEPFUN_CHAT_API_KEY=replace_with_text_model_api_key
STEPFUN_CHAT_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_CHAT_MODEL=step-3.5-flash-2603

# Advanced optional: set these only when ASR/TTS use separate credentials.
# STEPFUN_AUDIO_API_KEY=replace_with_audio_api_key
# STEPFUN_AUDIO_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_TTS_MODEL=stepaudio-2.5-tts
STEPFUN_ASR_MODEL=stepaudio-2.5-asr
STEPFUN_TTS_VOICE=zixinnansheng

# Optional (recommended): use native YouTube captions before yt-dlp or ASR.
# SUPADATA_API_KEY=replace_with_supadata_api_key
# SUPADATA_BASE_URL=https://api.supadata.ai/v1

# Backward-compatible fallback:
# STEPFUN_API_KEY=replace_with_single_key_for_all_stepfun_calls
# STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1

# Required for the recommended Apple Podcasts workflow. Leave unset for local-only MP3 output.
# Publish MP3 files, show artwork, and feed.xml to your own Cloudflare R2 bucket.
# Configure the bucket and API credentials in Cloudflare first. This file never contains
# credentials supplied by the project. R2_PUBLIC_BASE_URL must be your public R2
# development URL or custom domain.
# Episode links use canonical YouTube URLs by default. Set false to hide source links.
PODCASTCLIP_RSS_INCLUDE_SOURCE_URL=true
# PODCASTCLIP_STORAGE_BACKEND=local
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=podcastclip
# R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
# R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
# R2_REGION=auto
# R2_PREFIX=podcastclip
# R2_PUBLIC_BASE_URL=https://your-r2-public-domain.example
